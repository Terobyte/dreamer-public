{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@iwsdk/vite-plugin-dev/client"
    ],
    "paths": {
      "three": [
        "./node_modules/@types/three/index.d.ts"
      ],
      "three/addons/*": [
        "./node_modules/@types/three/examples/jsm/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
