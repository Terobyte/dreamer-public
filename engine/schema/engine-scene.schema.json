{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-world/engine-scene.schema.json",
  "title": "engine-scene v0",
  "type": "object",
  "required": ["version", "name", "spawn", "levels", "rooms", "materials", "assets"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 0 },
    "name": { "type": "string", "minLength": 1 },
    "spawn": {
      "type": "object",
      "required": ["room", "at"],
      "additionalProperties": false,
      "properties": {
        "room": { "type": "string" },
        "at": { "$ref": "#/$defs/point2" },
        "yaw": { "type": "number", "default": 0 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambient": { "type": "number", "default": 1.0 },
        "exterior": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#808080" },
        "tone": { "type": "string", "enum": ["neutral", "none"], "description": "runtime tone mapping; none = off (unlit, shadowless worlds)" },
        "exposure": { "type": "number", "exclusiveMinimum": 0, "maximum": 4, "description": "tone mapping exposure, default 0.9" }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tile": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "repeat_m": { "type": "number", "minimum": 0, "default": 1.0 }
        },
        "allOf": [{ "not": { "required": ["tile", "color"] } }]
      }
    },
    "outdoor": {
      "type": "object",
      "required": ["sky", "ground"],
      "additionalProperties": false,
      "properties": {
        "sky": { "type": "string" },
        "ground": {
          "type": "object",
          "required": ["material", "radius", "fade"],
          "additionalProperties": false,
          "properties": {
            "material": { "type": "string" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "fade": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "y"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "y": { "type": "number" }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level", "floor"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "level": { "type": "string" },
          "open": { "type": "boolean" },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "shape": {
            "type": "array",
            "items": { "$ref": "#/$defs/vertex" }
          },
          "circle": {
            "type": "object",
            "required": ["c", "r"],
            "additionalProperties": false,
            "properties": {
              "c": { "$ref": "#/$defs/point2" },
              "r": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "floor": { "type": "string" },
          "ceiling": { "type": "string" },
          "facade": { "type": "string" },
          "roof": {
            "type": "object",
            "required": ["material", "kind"],
            "additionalProperties": false,
            "properties": {
              "material": { "type": "string" },
              "kind": { "enum": ["flat", "gable"] },
              "overhang": { "type": "number", "minimum": 0, "default": 0 }
            }
          },
          "walls": {
            "type": "object",
            "required": ["material"],
            "additionalProperties": false,
            "properties": {
              "material": { "type": "string" },
              "thickness": { "type": "number", "exclusiveMinimum": 0, "default": 0.12 },
              "bands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["to", "material"],
                  "additionalProperties": false,
                  "properties": {
                    "to": { "type": "number", "exclusiveMinimum": 0 },
                    "material": { "type": "string" }
                  }
                }
              }
            }
          },
          "edges": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["material"],
              "additionalProperties": false,
              "properties": {
                "material": { "type": "string" }
              }
            }
          },
          "beams": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "material"],
              "additionalProperties": false,
              "properties": {
                "from": { "$ref": "#/$defs/point2" },
                "to": { "$ref": "#/$defs/point2" },
                "material": { "type": "string" },
                "w": { "type": "number", "minimum": 0, "default": 0.2 },
                "h": { "type": "number", "minimum": 0, "default": 0.25 }
              }
            }
          }
        },
        "allOf": [
          { "not": { "required": ["shape", "circle"] } },
          {
            "if": { "not": { "required": ["open"], "properties": { "open": { "const": true } } } },
            "then": { "required": ["height", "walls", "ceiling"] }
          }
        ]
      }
    },
    "walls": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["level", "from", "to", "material"],
        "additionalProperties": false,
        "properties": {
          "level": { "type": "string" },
          "from": { "$ref": "#/$defs/point2" },
          "to": { "$ref": "#/$defs/point2" },
          "h": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "thickness": { "type": "number", "exclusiveMinimum": 0, "default": 0.12 },
          "material": { "type": "string" },
          "glass": { "type": "boolean", "default": false }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["kind", "room", "from", "to", "material"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["counter", "shelf", "cabinet-wall"] },
          "room": { "type": "string" },
          "from": { "$ref": "#/$defs/point2" },
          "to": { "$ref": "#/$defs/point2" },
          "depth": { "type": "number", "exclusiveMinimum": 0 },
          "h": { "type": "number", "exclusiveMinimum": 0 },
          "material": { "type": "string" },
          "top": { "type": "string" }
        }
      }
    },
    "stairs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "kind", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["straight"] },
          "from": {
            "type": "object",
            "required": ["room", "at", "dir"],
            "additionalProperties": false,
            "properties": {
              "room": { "type": "string" },
              "at": { "$ref": "#/$defs/point2" },
              "dir": { "type": "number" }
            }
          },
          "to": {
            "type": "object",
            "required": ["room"],
            "additionalProperties": false,
            "properties": { "room": { "type": "string" } }
          },
          "width": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
          "rise": { "type": "number", "exclusiveMinimum": 0, "default": 0.17 },
          "going": { "type": "number", "exclusiveMinimum": 0, "default": 0.28 },
          "rail": { "type": "boolean", "default": false }
        }
      }
    },
    "openings": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "kind", "width"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["door", "window", "arch", "gap"] },
          "at": { "$ref": "#/$defs/point2" },
          "on": { "$ref": "#/$defs/on" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "sill": { "type": "number", "minimum": 0 },
          "leaf": {
            "type": "object",
            "required": ["decal"],
            "additionalProperties": false,
            "properties": {
              "decal": { "type": "string" },
              "open": { "type": "boolean", "default": true },
              "swing": { "type": "string" },
              "hinge": { "enum": ["left", "right"] },
              "glass": { "type": "boolean" }
            }
          },
          "outside": {
            "type": "object",
            "required": ["backdrop"],
            "additionalProperties": false,
            "properties": {
              "backdrop": { "type": "string" }
            }
          },
          "to": { "type": "string", "description": "where the door leads (a door id or a portal id): who walks out through it comes in there, San Andreas style" }
        },
        "allOf": [{ "not": { "required": ["at", "on"] } }]
      }
    },
    "portals": {
      "type": "array",
      "default": [],
      "description": "door spots on an open place (a street has no wall to cut a door in); `to` as an opening's",
      "items": {
        "type": "object",
        "required": ["id", "room", "at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "room": { "type": "string" },
          "at": { "$ref": "#/$defs/point2" },
          "yaw": { "type": "number" },
          "name": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "props": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "asset", "room", "size"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "asset": { "type": "string" },
          "cat": { "type": "string" },
          "room": { "type": "string" },
          "at": { "$ref": "#/$defs/point2" },
          "on": { "$ref": "#/$defs/on" },
          "size": {
            "type": "object",
            "required": ["w", "d", "h"],
            "additionalProperties": false,
            "properties": {
              "w": { "type": "number", "minimum": 0 },
              "d": { "type": "number", "minimum": 0 },
              "h": { "type": "number", "minimum": 0 }
            }
          },
          "y": { "type": "number" },
          "mount": {
            "anyOf": [
              { "enum": ["floor", "ceiling", "wall"] },
              {
                "type": "object",
                "required": ["top_of"],
                "additionalProperties": false,
                "properties": {
                  "top_of": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["tier_of", "tier"],
                "additionalProperties": false,
                "properties": {
                  "tier_of": { "type": "string" },
                  "tier": { "type": "integer", "minimum": 0 }
                }
              }
            ],
            "default": "floor"
          },
          "face": {
            "anyOf": [
              { "const": "room" },
              { "type": "string" },
              { "$ref": "#/$defs/point2" }
            ]
          },
          "yaw": { "type": "number" },
          "around": {
            "type": "object",
            "required": ["center", "n", "r"],
            "additionalProperties": false,
            "properties": {
              "center": { "type": "string" },
              "n": { "type": "integer", "minimum": 1 },
              "r": { "type": "number", "minimum": 0 },
              "start": { "type": "number" }
            }
          },
          "solid": { "type": "boolean", "default": true }
        },
        "allOf": [
          { "not": { "required": ["at", "on"] } },
          { "not": { "required": ["face", "yaw"] } },
          { "not": { "required": ["around", "at"] } },
          { "not": { "required": ["around", "face"] } },
          { "not": { "required": ["around", "yaw"] } }
        ]
      }
    },
    "scatter": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["assets", "count", "area", "seed"],
        "additionalProperties": false,
        "properties": {
          "assets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "count": { "type": "integer", "minimum": 1 },
          "area": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
          "seed": { "type": "integer" },
          "avoid": { "type": "array", "items": { "$ref": "#/$defs/point2" } }
        }
      }
    },
    "decals": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["asset", "size"],
        "additionalProperties": false,
        "properties": {
          "asset": { "type": "string" },
          "room": { "type": "string" },
          "at": { "$ref": "#/$defs/point2" },
          "on": { "$ref": "#/$defs/on" },
          "rotation": { "type": "number" },
          "y": { "type": "number", "default": 1.6 },
          "size": {
            "type": "object",
            "required": ["w", "h"],
            "additionalProperties": false,
            "properties": {
              "w": { "type": "number", "minimum": 0 },
              "h": { "type": "number", "minimum": 0 }
            }
          }
        },
        "allOf": [{ "not": { "required": ["at", "on"] } }]
      }
    },
    "lights": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["point", "hemi", "sun"] },
          "pos": { "$ref": "#/$defs/point3" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#ffffff" },
          "power": { "type": "number", "default": 1.0 },
          "dir": { "$ref": "#/$defs/point3" },
          "intensity": { "type": "number", "minimum": 0 },
          "castShadow": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "required": ["kind"], "properties": { "kind": { "const": "point" } } },
            "then": { "required": ["pos"] }
          },
          {
            "if": { "required": ["kind"], "properties": { "kind": { "const": "sun" } } },
            "then": { "required": ["dir"] }
          }
        ]
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "prompt"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["tile", "decal", "object", "sky"] },
          "prompt": { "type": "string" },
          "aspect": { "type": "string", "default": "1:1" },
          "front_deg": { "type": "number", "default": 0 },
          "foliage": { "type": "boolean", "default": false, "description": "an object whose leaves are an opaque JPEG with no alpha (a Tripo tree): normalization cuts them out with MASK" },
          "ref": {
            "type": "object",
            "required": ["image", "what"],
            "additionalProperties": false,
            "description": "object only (REF_KIND otherwise): a picture of the place, path relative to the scene folder, and what to cut out of it",
            "properties": {
              "image": { "type": "string" },
              "what": { "type": "string" },
              "mode": { "enum": ["mask", "redraw"], "default": "mask", "description": "mask: SAM 3 cuts `what` out of the frame and SAM3D meshes it with that mask; redraw: Muse redraws it on white first (Н2)" }
            }
          }
        }
      }
    },
    "cameras": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "pos"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "ref": { "type": "string" },
          "pos": { "$ref": "#/$defs/point3" },
          "look": { "$ref": "#/$defs/point3" },
          "fov": { "type": "number", "exclusiveMinimum": 0, "default": 60 }
        }
      }
    },
    "routes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "path": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["room", "at"],
                  "additionalProperties": false,
                  "properties": {
                    "room": { "type": "string" },
                    "at": { "$ref": "#/$defs/point2" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "point2": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "point3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 3,
      "maxItems": 3
    },
    "vertex": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        {
          "type": "object",
          "required": ["bulge"],
          "additionalProperties": false,
          "properties": {
            "bulge": { "type": "number" }
          }
        }
      ],
      "minItems": 2,
      "maxItems": 3
    },
    "on": {
      "type": "object",
      "required": ["room", "edge"],
      "additionalProperties": false,
      "properties": {
        "room": { "type": "string" },
        "edge": { "type": "integer", "minimum": 0 },
        "t": { "type": "number", "minimum": 0, "maximum": 1 },
        "m": { "type": "number" },
        "az": { "type": "number" }
      },
      "allOf": [
        { "not": { "required": ["t", "m"] } },
        { "not": { "required": ["t", "az"] } },
        { "not": { "required": ["m", "az"] } }
      ]
    }
  }
}
